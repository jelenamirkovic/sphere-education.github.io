from mergexp import *
# create a topology named 'bgphijack'
net = Network('bgphijack', addressing==ipv4)
nodes = [net.node(name, image == 'bullseye-edu') for name in [ 'asn1','asn2','asn3','asn4','attacker','client','server' ]]
linklink4 = net.connect([nodes[2],nodes[3]])
linklink4[nodes[2]].socket.addrs = ip4('10.4.0.1/24')
linklink4[nodes[3]].socket.addrs = ip4('10.4.0.2/24')
linklink2 = net.connect([nodes[0],nodes[1]])
linklink2[nodes[0]].socket.addrs = ip4('10.2.0.1/24')
linklink2[nodes[1]].socket.addrs = ip4('10.2.0.2/24')
linklink1 = net.connect([nodes[0],nodes[6]])
linklink1[nodes[0]].socket.addrs = ip4('10.1.1.1/24')
linklink1[nodes[6]].socket.addrs = ip4('10.1.1.2/24')
linklink3 = net.connect([nodes[1],nodes[2]])
linklink3[nodes[1]].socket.addrs = ip4('10.3.0.2/24')
linklink3[nodes[2]].socket.addrs = ip4('10.3.0.1/24')
linklink6 = net.connect([nodes[3],nodes[4]])
linklink6[nodes[3]].socket.addrs = ip4('10.6.1.1/24')
linklink6[nodes[4]].socket.addrs = ip4('10.6.1.2/24')
linklink5 = net.connect([nodes[2],nodes[5]])
linklink5[nodes[2]].socket.addrs = ip4('10.5.0.1/24')
linklink5[nodes[5]].socket.addrs = ip4('10.5.0.2/24')
experiment(net)
