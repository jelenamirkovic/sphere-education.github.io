from mergexp import *

# Create a network topology object. This network will automatically
# add IP addresses to all node interfaces and configure static routes
# between all experiment nodes. 
net = Network('phish', addressing==ipv4, routing==static)

# Creating the node.
nodes = [net.node(name, image == 'bullseye-edu') for name in [ 'ctfpass']]
nodes[0].ingress(http,"80")
nodes[0].ingress(https,"443")
net.connect([nodes[0]])

# Making the experiment runnable.
experiment(net)
