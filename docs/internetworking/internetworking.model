from mergexp import *
# create a topology named 'internetworking'
net = Network('internetworking', addressing==ipv4, routing==static)
nodes = [net.node(name, image == 'bullseye-edu') for name in [ 'ISrouter','NWrouter','NWworkstation1','SWrouter','SWworkstation1' ]]
linklinkNWpublic = net.connect([nodes[0],nodes[1]])
linklinkNWpublic[nodes[0]].socket.addrs = ip4('22.0.0.1/24')
linklinkNWpublic[nodes[1]].socket.addrs = ip4('22.0.0.2/24')
linklinkSWpublic = net.connect([nodes[0],nodes[3]])
linklinkSWpublic[nodes[0]].socket.addrs = ip4('33.0.0.2/24')
linklinkSWpublic[nodes[3]].socket.addrs = ip4('33.0.0.1/24')
lanlanNW = net.connect([nodes[1],nodes[2]])
lanlanNW[nodes[1]].socket.addrs = ip4('11.0.0.1/24')
lanlanNW[nodes[2]].socket.addrs = ip4('11.0.0.2/24')
lanlanSW = net.connect([nodes[3],nodes[4]])
lanlanSW[nodes[3]].socket.addrs = ip4('44.0.0.1/24')
lanlanSW[nodes[4]].socket.addrs = ip4('44.0.0.2/24')
experiment(net)

