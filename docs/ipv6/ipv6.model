from mergexp import *
# create a topology named 'ipv6'
net = Network('ipv6', addressing==ipv4, routing==static)
nodes = [net.node(name, image == 'bullseye-edu') for name in ['client','router','server' ]]
linklink1 = net.connect([nodes[1],nodes[2]])
linklink1[nodes[1]].socket.addrs = ip4('5.6.7.2/24')
linklink1[nodes[2]].socket.addrs = ip4('5.6.7.8/24')
lanlan1 = net.connect([nodes[0],nodes[1]])
lanlan1[nodes[0]].socket.addrs = ip4('1.1.2.3/24')
lanlan1[nodes[1]].socket.addrs = ip4('1.1.2.2/24')
experiment(net)
