set ns [new Simulator]
source tb_compat.tcl

foreach node { blueserver bluegateway redserver redgateway } {
   set $node [$ns node]
   tb-set-node-os [set $node] Ubuntu-EDUtest
   tb-set-node-startcmd [set $node] "/share/education/CTF_Bank/start.sh"
}

set linkmixed [$ns duplex-link $bluegateway $redgateway 1Gb 0ms DropTail]
set bluelan [$ns make-lan "$blueserver $bluegateway" 1000000.0kb 0.0ms]
set redlan [$ns make-lan "$redserver $redgateway" 1000000.0kb 0.0ms]

tb-set-ip-lan $blueserver $bluelan 1.1.1.5
tb-set-ip-lan $bluegateway $bluelan 1.1.1.2
tb-set-ip-link $bluegateway $linkmixed 10.1.1.2
tb-set-ip-lan $redserver $redlan 2.2.2.5
tb-set-ip-lan $redgateway $redlan 2.2.2.2
tb-set-ip-link $redgateway $linkmixed 10.1.1.3

$ns rtproto Static
$ns run