set ns [new Simulator]
source tb_compat.tcl

set lanstr ""
set server [$ns node]
tb-set-node-os $server Ubuntu-EDU
append lanstr "$server "

set client [$ns node]
append lanstr "$client "
tb-set-node-os $client Ubuntu-EDU
set attacker [$ns node]
append lanstr "$attacker "
tb-set-node-os $attacker Ubuntu-EDU

set lan0 [$ns make-lan "$lanstr" 1Gb 0ms]

$ns rtproto Static
$ns run