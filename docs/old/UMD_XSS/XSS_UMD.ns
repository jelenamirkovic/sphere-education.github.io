set ns [new Simulator]
source tb_compat.tcl

set client [$ns node]
tb-set-node-os $client Ubuntu-EDU
set server [$ns node]
tb-set-node-os $server Ubuntu-EDU
tb-set-node-startcmd $server "sudo /share/education/UMD_XSS/install_server >& /tmp/labinstall.log"
tb-set-node-startcmd $client "sudo /share/education/UMD_XSS/install_client >& /tmp/labinstall.log"


set link0 [$ns duplex-link $client $server 100Mb 0ms DropTail]

ns rtproto Static
ns run

