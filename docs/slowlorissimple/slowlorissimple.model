from mergexp import *
# create a topology named 'slowloris'
net = Network('slowloris', addressing==ipv4, routing==static)
nodes = [net.node(name, image == 'bullseye-edu') for name in [ 'attacker','client','server' ]]
lanlan0 = net.connect([nodes[0],nodes[1],nodes[2]])
lanlan0[nodes[0]].socket.addrs = ip4('10.1.1.4/24')
lanlan0[nodes[1]].socket.addrs = ip4('10.1.1.3/24')
lanlan0[nodes[2]].socket.addrs = ip4('10.1.1.2/24')
nodes[2].ingress(http,"80")
nodes[2].ingress(https,"443")
experiment(net)
