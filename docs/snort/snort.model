from mergexp import *
# create a topology named 'ssec'
net = Network('ssec', addressing==ipv4, routing==static)
nodes = [net.node(name, image == 'bullseye-edu') for name in [ 'client1','client2','internal','outsider','router','server','snort' ]]
linknetworkLink = net.connect([nodes[4],nodes[6]])
linknetworkLink[nodes[4]].socket.addrs = ip4('10.1.1.3/24')
linknetworkLink[nodes[6]].socket.addrs = ip4('10.1.1.2/24')
linkoutLink = net.connect([nodes[3],nodes[4]])
linkoutLink[nodes[3]].socket.addrs = ip4('100.1.200.10/24')
linkoutLink[nodes[4]].socket.addrs = ip4('100.1.200.2/24')
lanlan2 = net.connect([nodes[2],nodes[5],nodes[6]])
lanlan2[nodes[2]].socket.addrs = ip4('100.1.10.3/24')
lanlan2[nodes[5]].socket.addrs = ip4('100.1.10.10/24')
lanlan2[nodes[6]].socket.addrs = ip4('100.1.10.2/24')
lanlan0 = net.connect([nodes[0],nodes[1],nodes[4]])
lanlan0[nodes[0]].socket.addrs = ip4('100.1.5.10/24')
lanlan0[nodes[1]].socket.addrs = ip4('100.1.5.11/24')
lanlan0[nodes[4]].socket.addrs = ip4('100.1.5.2/24')
experiment(net)

