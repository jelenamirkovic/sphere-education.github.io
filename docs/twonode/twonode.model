from mergexp import *
# create a topology named 'twonode'
net = Network('twonode', addressing==ipv4, routing==static)
nodes = [net.node(name, image == 'bullseye-edu') for name in [ 'a','b']]
lanlan0 = net.connect([nodes[0],nodes[1]])
lanlan0[nodes[0]].socket.addrs = ip4('10.1.1.2/24')
lanlan0[nodes[1]].socket.addrs = ip4('10.1.1.3/24')
experiment(net)

